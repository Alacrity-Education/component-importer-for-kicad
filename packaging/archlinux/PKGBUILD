# Maintainer: Alexandru Iercosan-Lucaci <alex.lucaci@alacrity.ro>
pkgname=kicad-component-importer-git
_distname=component-importer-for-kicad
pkgver=0.1.0
pkgrel=1
pkgdesc="Open source desktop app and CLI for importing downloaded component ZIP libraries into KiCad projects"
arch=('any')
url="https://github.com/Alacrity-Education/component-importer-for-kicad"
license=('MIT')
depends=('python' 'python-pyqt6')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'git')
optdepends=('fzf: fuzzy ZIP picker for the CLI'
            'kicad: EDA suite the imported libraries are used with')
provides=('kicad-component-importer')
conflicts=('kicad-component-importer')
source=("${pkgname}::git+https://github.com/Alacrity-Education/component-importer-for-kicad.git#branch=feat-cli")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/${pkgname}"
  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/CLI.md "${pkgdir}/usr/share/doc/${pkgname}/CLI.md"
}
